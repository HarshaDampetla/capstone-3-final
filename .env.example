# MarketScope Application Environment Variables

# App Config
APP_NAME=MarketScope
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_secret_key_in_production_32bytes_min

# Database
DATABASE_URL=sqlite:///./marketscope.db

# JWT & Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Market Data Feed Configuration
MARKET_DATA_TICK_SECONDS=5
MARKET_DATA_RANDOM_WALK_STDDEV=0.02
