{
  "name": "marketscope-substrate-plugin",
  "version": "1.0.0",
  "description": "MarketScope AI-Native Substrate Plugin packaging custom agents, skills, commands, hooks, and Playwright MCP integration.",
  "author": "AI-Native Engineer",
  "agents": [
