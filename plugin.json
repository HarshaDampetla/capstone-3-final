    ".claude/agents/user-management-agent.md",
    ".claude/agents/crud-scaffolder-agent.md",
    ".claude/agents/watchlist-validator-agent.md",
    ".claude/agents/ac-test-generator-agent.md",
    ".claude/agents/financial-rules-agent.md",
    ".claude/agents/documentation-agent.md"
  ],
  "skills": [
    ".claude/skills/order-lifecycle-validator/SKILL.md",
    ".claude/skills/portfolio-pnl-calculator/SKILL.md",
    ".claude/skills/watchlist-validator/SKILL.md",
    ".claude/skills/architecture-test-author/SKILL.md",
    ".claude/skills/financial-decimal-reviewer/SKILL.md",
